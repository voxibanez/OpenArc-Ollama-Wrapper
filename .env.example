OPENARC_IMAGE=ghcr.io/voxibanez/openarc:latest
OLLAMA_FACADE_IMAGE=ghcr.io/voxibanez/openarc-ollama-wrapper:latest
OPENARC_API_KEY=openarc-default-key
MODEL_PATH=./models
MAX_LOADED_MODELS=1
DEFAULT_KEEP_ALIVE=60s
OPENARC_DEFAULT_DEVICE=GPU.0
OLLAMA_FACADE_GOMEMLIMIT=128MiB
OLLAMA_FACADE_GOGC=50
MAX_REQUEST_BYTES=16777216
MAX_RESPONSE_BYTES=67108864
MAX_STREAM_LINE_BYTES=2097152
